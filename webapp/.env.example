# PostgreSQL connection string
# محلّياً (مع docker-compose):
DATABASE_URL=postgresql://rayhana:rayhana@localhost:5432/rayhana

# على Render: ضع رابط الـInternal Database URL

# كلمة المرور للدخول إلى الموقع (مستخدم واحد)
APP_PASSWORD=change-me-to-a-strong-password

# سر توقيع الـcookie (ولّد قيمة عشوائية طويلة)
SESSION_SECRET=replace-with-long-random-string

# المنفذ المحلّي (Render يضبطه تلقائياً)
PORT=3000

# بيئة التشغيل: development | production
NODE_ENV=development
